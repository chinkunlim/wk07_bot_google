# 轉接站 (npm run relay) 與本機模擬 (npm run simulate) 用的設定；複製為 gas/.env 後填入
# GAS 本身不讀這個檔案，請在「專案設定 → 指令碼屬性」設定
# gas/.env 已加入 .gitignore，不會上傳到 GitHub

# === 轉接站需要 (與 GAS 指令碼屬性相同) ===
TELEGRAM_BOT_TOKEN=
# GAS 網頁應用程式網址 (/exec 結尾)
WEBHOOK_URL=
# GAS 執行 setWebhook 後自動產生，到指令碼屬性複製
WEBHOOK_SECRET=
# 轉接站結束 (Ctrl+C) 時是否把 webhook 設回 GAS，讓電腦關機期間由 GAS 獨立回答 (預設 true)
# RELAY_RESTORE_WEBHOOK=true

# === 本機模擬 (npm run simulate) 需要 ===
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ALLOWED_USER_IDS=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# SEARCH_DECISION=router
# SEARCH_ENGINE=duckduckgo
# SEARCH_FALLBACK_ENGINE=multi
