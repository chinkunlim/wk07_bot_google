# 本機模擬 (npm run simulate) 用的設定；複製為 gas/.env 後填入
# 部署到 GAS 時不讀這個檔案，請改在「專案設定 → 指令碼屬性」設定

# 必填：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 選填 (未填使用預設值，說明見 gas/README.md)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# SEARCH_DECISION=router
# SEARCH_ENGINE=duckduckgo
# SEARCH_FALLBACK_ENGINE=multi
# SEARCH_FETCH_PAGES=2
# SEARCH_PAGE_CHARS=2000
# MAX_HISTORY_TURNS=4
# MAX_DAILY_REQUESTS=50
