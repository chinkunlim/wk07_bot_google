# 轉接站 (npm run relay) 與本機模擬 (npm run simulate) 用的設定；複製為 gas/.env 後填入
# 部署到 GAS 的部分不讀這個檔案，請在「專案設定 → 指令碼屬性」設定相同的值
# gas/.env 已加入 .gitignore，不會上傳到 GitHub

# 必填 (模擬與轉接站)：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 轉接站另外需要 (與 GAS 指令碼屬性相同)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# GAS 部署的網頁應用程式網址 (/exec 結尾)
WEBHOOK_URL=
# GAS 執行 setWebhook 後自動產生，到指令碼屬性複製
WEBHOOK_SECRET=

# 選填 (未填使用預設值，說明見 README.md)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# SEARCH_DECISION=router
# SEARCH_ENGINE=duckduckgo
# SEARCH_FALLBACK_ENGINE=multi
# SEARCH_FETCH_PAGES=2
# SEARCH_PAGE_CHARS=2000
# MAX_HISTORY_TURNS=4
# MAX_DAILY_REQUESTS=50
